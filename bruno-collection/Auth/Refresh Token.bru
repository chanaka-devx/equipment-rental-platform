meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzYjU0YWNhOC00OWZjLTQ5MTgtODU1Mi1mMzUwMzlmZWFiODIiLCJpYXQiOjE3ODYzMzE4MzEsImV4cCI6MTc4NjkzNjYzMX0.fWoRiSDZtu_wJl2DQH82TDqf4d2_6Oih7DdvD9oT_BA"
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    if (body.access_token) {
      bru.setVar("access_token", body.access_token);
    }
  }
}
