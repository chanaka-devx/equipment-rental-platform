meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@test.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    if (body.accessToken) {
      bru.setEnvVar("access_token", body.accessToken);
    }
  }
}
