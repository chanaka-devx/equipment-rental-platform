generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  STAFF
  CUSTOMER
  WAREHOUSE_OPERATOR
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(CUSTOMER)
  reservations Reservation[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id        String      @id @default(uuid())
  name      String      @unique
  equipment Equipment[]
}

model Equipment {
  id               String            @id @default(uuid())
  name             String
  description      String
  images           String[]
  rentalPrice      Decimal           @db.Decimal(12, 2)
  deposit          Decimal           @db.Decimal(12, 2)
  stockQuantity    Int
  available        Boolean           @default(true)
  specifications   Json?
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  reservationItems ReservationItem[]
  createdAt        DateTime          @default(now())

  @@index([categoryId])
}

model Reservation {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  status       ReservationStatus  @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  items        ReservationItem[]
  payment      Payment?
  createdAt    DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate]) 
}

model ReservationItem {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  equipmentId   String
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(12, 2) 

  @@index([reservationId])
  @@index([equipmentId])
}

model Payment {
  id            String        @id @default(uuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Upload {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "ID_DOCUMENT" | "RENTAL_AGREEMENT" | "EQUIPMENT_IMAGE"
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
}


